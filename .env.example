# Public site URL (used for canonical tags, sitemap.xml, schema)
NEXT_PUBLIC_SITE_URL=https://www.example-expat-tax.com

# External client portal (link-out only, no SSO)
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://portal.example.com

# Optional: Calendly (or similar) scheduling link. If unset, the native booking form is used.
NEXT_PUBLIC_BOOKING_EMBED_URL=

# Optional: GA4 measurement ID. Loads only after analytics consent.
NEXT_PUBLIC_GA_ID=

# Optional: where lead submissions are forwarded (CRM / Zapier / Make webhook).
# If unset, submissions are validated and logged to the server console only.
LEAD_WEBHOOK_URL=
